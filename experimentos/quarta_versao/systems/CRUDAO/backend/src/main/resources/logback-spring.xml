<?xml version="1.0" encoding="UTF-8"?>
<!--
  TASK-08.2 — Observabilidade final.
  Log tradicional Linux (observability.md): arquivo local, rotação a cada 5MB,
  retenção dos 10 arquivos mais recentes (purge automático dos antigos).
  Console mantido para `docker logs`. Sem formato estruturado nesta fase.
-->
<configuration>
  <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

  <property name="LOG_DIR" value="${LOG_DIR:-logs}"/>
  <property name="LOG_FILE" value="${LOG_DIR}/kanban-backend.log"/>

  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>${CONSOLE_LOG_PATTERN}</pattern>
      <charset>UTF-8</charset>
    </encoder>
  </appender>

  <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <file>${LOG_FILE}</file>
    <encoder>
      <pattern>${FILE_LOG_PATTERN}</pattern>
      <charset>UTF-8</charset>
    </encoder>
    <!-- Rotação por tamanho: 5MB por arquivo; retenção de 10 arquivos no total
         (o ativo + 9 históricos), conforme observability.md. -->
    <rollingPolicy class="ch.qos.logback.core.rolling.FixedWindowRollingPolicy">
      <fileNamePattern>${LOG_DIR}/kanban-backend.%i.log</fileNamePattern>
      <minIndex>1</minIndex>
      <maxIndex>9</maxIndex>
    </rollingPolicy>
    <triggeringPolicy class="ch.qos.logback.core.rolling.SizeBasedTriggeringPolicy">
      <maxFileSize>5MB</maxFileSize>
    </triggeringPolicy>
  </appender>

  <root level="INFO">
    <appender-ref ref="CONSOLE"/>
    <appender-ref ref="FILE"/>
  </root>
</configuration>
